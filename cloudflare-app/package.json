{
  "name": "prosno-io-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build:client": "vite build",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:client && npm run typecheck",
    "db:migrate:local": "wrangler d1 migrations apply prosno-db --local",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "docx": "^9.5.0",
    "hono": "^4.7.0",
    "katex": "^0.16.21"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "wrangler": "^4.168.0"
  }
}
